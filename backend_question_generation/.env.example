# LeetSwipe question-generation configuration.
# Copy to .env (git-ignored) and fill in the key(s) you have.

# Anthropic key — preferred provider (default model: claude-opus-4-8).
# Get one at https://console.anthropic.com/. Use --model claude-haiku-4-5 for a cheaper run.
ANTHROPIC_API_KEY=

# OpenAI key — alternative provider (default model: gpt-4o-mini).
OPENAI_API_KEY=

# MongoDB Atlas connection string — only needed when writing to the database
# (omit for --dry-run / --app-out runs).
MONGODB_KEY=
