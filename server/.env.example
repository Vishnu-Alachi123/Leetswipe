# LeetSwipe API configuration
# MongoDB Atlas connection string (same cluster the generator writes to).
MONGODB_KEY=
# Secret used to sign JWTs. Required in production — see auth.ts, the server
# refuses to boot with NODE_ENV=production and this unset. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
# Port the API listens on (default 4000). Most hosts (Render, Railway, Fly)
# set this automatically; leave it unset unless running standalone.
PORT=4000

# Google OAuth client IDs, for verifying sign-in id_tokens server-side.
# NOT the same variables as the app's EXPO_PUBLIC_GOOGLE_*_CLIENT_ID (those are
# baked into the public web/app bundle; these stay server-side, though for
# Google OAuth the values themselves are the same, just without the
# EXPO_PUBLIC_ prefix here). At least one must be set for Google sign-in to
# work; see ../GOOGLE_SIGNIN.md.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
